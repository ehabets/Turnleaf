          "command": "turnleaf.sendReviewed",
          "when": "false"
        },
        {
          "command": "turnleaf.refreshComments",
          "when": "false"
        },
        {
          "command": "turnleaf.editComment",
          "when": "false"
        },
        {
          "command": "turnleaf.cancelCommentEdit",
          "when": "false"
        },
        {
          "command": "turnleaf.saveComment",
          "when": "false"
        },
        {
          "command": "turnleaf.deleteComment",
          "when": "false"
        },
        {
          "command": "turnleaf.resolveConflict",
          "when": "false"
        },
        {
          "command": "turnleaf.useResolution",
          "when": "false"
        },
        {
          "command": "turnleaf.editMessage",
          "when": "false"
        },
        {
          "command": "turnleaf.deleteMessage",
          "when": "false"
        },
        {
          "command": "turnleaf.acceptAllChanges",
          "when": "false"
        },
        {
          "command": "turnleaf.rejectAllChanges",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "turnleaf.reply",
          "when": "commentController == turnleaf-local",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "turnleaf.checkRemote",
          "when": "view == turnleaf.project",
          "group": "navigation"
        },
        {
          "command": "turnleaf.showReviewPanel",
          "when": "view == turnleaf.project",
          "group": "navigation"
        }
      ],
      "comments/comment/title": [
        {
          "command": "turnleaf.editComment",
          "when": "commentController == turnleaf-local && comment == overleaf.ownMessage",
          "group": "inline@1"
        },
        {
          "command": "turnleaf.deleteComment",
          "when": "commentController == turnleaf-local && comment == overleaf.ownMessage",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "turnleaf.saveComment",
          "when": "commentController == turnleaf-local",
          "group": "inline@1"
        },
        {
          "command": "turnleaf.cancelCommentEdit",
          "when": "commentController == turnleaf-local",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "turnleaf.resolve",
          "group": "inline@1",
          "when": "commentController == turnleaf-local && commentThread =~ /^overleaf\\.open\\./"
        },
        {
          "command": "turnleaf.reopen",
          "group": "inline@1",
          "when": "commentController == turnleaf-local && commentThread =~ /^overleaf\\.resolved\\./"
        },
        {
          "submenu": "turnleaf.threadMore",
          "group": "inline@9",
          "when": "commentController == turnleaf-local"
        }
      ],
      "editor/context": [
        {
          "command": "turnleaf.newComment",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "overleaf@1"
        }
      ],
      "turnleaf.threadMore": [
        {
          "command": "turnleaf.markAddressed",
          "group": "1_local@1",
          "when": "commentThread =~ /\\.local-open$/"
        },
        {
          "command": "turnleaf.markDeclined",
          "group": "1_local@2",
          "when": "commentThread =~ /\\.local-open$/"
        },
        {
          "command": "turnleaf.markOpen",
          "group": "1_local@3",
          "when": "commentThread =~ /\\.local-(addressed|declined)$/"
        },
        {
          "command": "turnleaf.openOverleaf",
          "group": "2_overleaf@1"
        },
        {
          "command": "turnleaf.deleteThread",
          "group": "3_delete@1"
        }
      ]
    },
