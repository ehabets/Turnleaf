    "configuration": [
      {
        "title": "Turnleaf",
        "properties": {
          "turnleaf.baseUrl": {
            "type": "string",
            "default": "https://www.overleaf.com",
            "scope": "resource",
            "description": "Overleaf server address."
          },
          "turnleaf.browserPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "Chromium-based browser (Chrome, Edge, Brave or Chromium) used for Sign In with Browser. Leave empty to detect one."
          },
          "turnleaf.projectId": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "Linked Overleaf project ID."
          },
          "turnleaf.trackedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "description": "Project-relative source files to review and synchronize. Set by Choose files; nothing is synchronized until files are chosen."
          },
          "turnleaf.reviewLogPath": {
            "type": "string",
            "default": "docs/overleaf_review_log.md",
            "scope": "resource",
            "description": "Generated review log path. Export overwrites this file."
          },
          "turnleaf.historyLimit": {
            "type": "number",
            "default": 50,
            "minimum": 0,
            "scope": "resource",
            "description": "Finished sync-history records to keep. 0 keeps all. Records an interrupted sync still needs are always kept."
          },
          "turnleaf.historyDays": {
            "type": "number",
            "default": 90,
            "minimum": 0,
            "scope": "resource",
            "description": "Remove finished sync-history records older than this many days. 0 keeps them regardless of age."
          },
          "turnleaf.syncPictures": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Get latest also brings in the PNG, JPG and PDF files of the Overleaf project, compared by content. Off leaves local pictures alone."
          },
          "turnleaf.commentMarkers": {
            "type": "string",
            "enum": [
              "belowParagraph",
              "commentedLine"
            ],
            "enumDescriptions": [
              "On the blank line under the commented line. Without a blank line there, no marker: the highlighted text shows the comment, and hovering it opens the thread.",
              "On the line where the comment ends, repeated on each wrapped row of that line."
            ],
            "default": "belowParagraph",
            "scope": "resource",
            "description": "Where comment markers go in the gutter while word wrap is on. Cursor draws a marker on every wrapped row of its line; with word wrap off, markers stay on the commented line."
          },
          "turnleaf.localReviewFiles": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Keep the project's comments as files under .turnleaf/projects/<key>/review/, where AI agents and scripts can read them and queue replies, resolutions and new comments. What they queue is published only by Send. Off imports what was saved there and removes the folder; queued drafts stay."
          },
          "turnleaf.allowWrites": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "description": "Allow reviewed uploads and explicit comment actions. Can be changed in Project setup."
          },
          "turnleaf.liveUpdates": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Keep one connection to the linked Overleaf project open and show its edits and comments as they happen. A 60-second check over the same connection catches anything missed. Pauses while the window is in the background."
          },
          "turnleaf.sendCheck": {
            "type": "string",
            "enum": [
              "full",
              "fast"
            ],
            "enumDescriptions": [
              "Before and after writing, Send reads every selected file from Overleaf.",
              "With a live connection, Send re-reads only the files Overleaf reported as edited and the files it wrote. Without one, Send reads in full."
            ],
            "default": "full",
            "scope": "resource",
            "markdownDescription": "How Send checks Overleaf around its writes. **Fast** is quicker on projects with many files, but relies on Overleaf reporting every edit over the live connection: an edit made after Send's first read that it fails to report is not seen before writing, and the check after writing catches it only in a file this Send wrote."
          },
          "turnleaf.remoteCheckInterval": {
            "type": "number",
            "enum": [
              0,
              10,
              30,
              60
            ],
            "enumDescriptions": [
              "Only check when requested.",
              "Every 10 seconds.",
              "Every 30 seconds.",
              "Every 60 seconds."
            ],
            "default": 10,
            "scope": "resource",
            "description": "When live updates are off: how often to check the selected remote files and comments, without applying updates. Checks back off after failures."
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "turnleaf.setCheckInterval",
          "when": "false"
        },
        {
          "command": "turnleaf.pushDryRun",
          "when": "false"
