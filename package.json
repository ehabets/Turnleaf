{
  "name": "turnleaf",
  "displayName": "Turnleaf",
  "description": "Review Overleaf comments and suggestions in VS Code or Cursor, merge incoming edits, and send reviewed changes back to Overleaf.",
  "version": "0.10.2",
  "publisher": "zeyuxu",
  "icon": "media/brand/turnleaf-icon.png",
  "galleryBanner": {
    "color": "#12355B",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "overleaf",
    "latex",
    "tex",
    "comments",
    "review",
    "track changes",
    "sync"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onCommand:turnleaf.signIn",
    "onCommand:turnleaf.signInWithCookie",
    "onCommand:turnleaf.linkProject",
    "onCommand:turnleaf.inspectProject",
    "onCommand:turnleaf.signOut",
    "onCommand:turnleaf.openInspectedFile",
    "onCommand:turnleaf.refreshComments",
    "onCommand:turnleaf.pull",
    "onCommand:turnleaf.markReconciled",
    "onCommand:turnleaf.push",
    "onCommand:turnleaf.pushDryRun",
    "onCommand:turnleaf.exportReviewLog",
    "onCommand:turnleaf.filterThreadsByAuthor",
    "onCommand:turnleaf.openThread",
    "onCommand:turnleaf.markAddressed",
    "onCommand:turnleaf.markDeclined",
    "onCommand:turnleaf.markOpen",
    "onCommand:turnleaf.reply",
    "onCommand:turnleaf.resolve",
    "onCommand:turnleaf.reopen",
    "onCommand:turnleaf.showReviewPanel",
    "onCommand:turnleaf.exportReviewPdf",
    "onStartupFinished",
    "onCommand:turnleaf.verifySnapshotLink",
    "onCommand:turnleaf.configureFiles",
    "onView:turnleaf.project"
