    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Turnleaf",
        "description": "Review Overleaf comments and suggestions in your editor, and send reviewed changes back.",
        "steps": [
          {
            "id": "openFolder",
            "title": "Open the folder of your paper",
            "description": "Turnleaf works in an ordinary local folder that holds, or will hold, your LaTeX sources. Git is not needed.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "media/walkthrough/open-folder.md"
            },
            "completionEvents": [
              "onContext:workspaceFolderCount > 0"
            ],
            "when": "workspaceFolderCount == 0"
          },
          {
            "id": "signIn",
            "title": "Sign in to Overleaf",
            "description": "A separate browser window opens for you to sign in to Overleaf and closes once you are signed in. The session is kept in the editor's secret storage and in the private browser profile until you sign out.\n[Sign in with browser](command:turnleaf.signIn)\nNo Chrome, Edge, Brave or Chromium? [Paste a session cookie](command:turnleaf.signInWithCookie) instead.",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onCommand:turnleaf.signIn",
              "onCommand:turnleaf.signInWithCookie"
            ],
            "when": "workspaceFolderCount > 0"
          },
          {
            "id": "linkProject",
            "title": "Choose your Overleaf project",
            "description": "Pick the project this folder belongs to. Each folder links to one project.\n[Choose project](command:turnleaf.linkProject)",
            "media": {
              "markdown": "media/walkthrough/link-project.md"
            },
            "completionEvents": [
              "onSettingChanged:turnleaf.projectId"
            ],
            "when": "workspaceFolderCount > 0"
          },
          {
            "id": "chooseFiles",
            "title": "Choose the files to synchronize",
            "description": "Nothing is synchronized until files are chosen. The first time, the list starts with every source file on Overleaf ticked, the main document first.\n[Choose files](command:turnleaf.configureFiles)",
            "media": {
              "markdown": "media/walkthrough/choose-files.md"
            },
            "completionEvents": [
              "onSettingChanged:turnleaf.trackedFiles"
            ],
            "when": "workspaceFolderCount > 0"
          },
          {
            "id": "getLatest",
            "title": "Get the latest version",
            "description": "Get latest shows what changed on Overleaf as a merge preview. Your files change only when you choose Apply (n) in the preview.\n[Get latest](command:turnleaf.pull)",
            "media": {
              "markdown": "media/walkthrough/get-latest.md"
            },
            "completionEvents": [
              "onCommand:turnleaf.pull",
              "onCommand:turnleaf.applyReviewed"
            ],
            "when": "workspaceFolderCount > 0"
          },
          {
            "id": "review",
            "title": "Review comments and suggestions",
            "description": "Comments appear next to your source and in the Turnleaf sidebar. Reply, resolve, or select text and choose New Comment on Selection.\n[Open the sidebar](command:turnleaf.showOverview)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onCommand:turnleaf.showOverview",
              "onView:turnleaf.project"
            ],
            "when": "workspaceFolderCount > 0"
          },
          {
            "id": "send",
            "title": "Enable sending, then Send",
            "description": "Sending is off until you enable it for this project, in the Setup tab of the sidebar. The outgoing summary then lists every file and comment change, and Send writes exactly that.\n[Open the sidebar](command:turnleaf.showOverview) and select Setup.",
            "media": {
              "markdown": "media/walkthrough/send.md"
            },
            "completionEvents": [
              "onSettingChanged:turnleaf.allowWrites"
            ],
            "when": "workspaceFolderCount > 0"
          }
        ]
      }
    ]
  },
